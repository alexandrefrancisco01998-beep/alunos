<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Tema base: conteúdo é 100% Compose, então só precisamos do essencial. -->
    <style name="Theme.MeuFilho" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">true</item>
    </style>

    <!--
        Tema de splash usando a SplashScreen API do Android 12+ (core-splashscreen
        garante compatibilidade retroativa). Mostra o ícone do app por uma
        fração de segundo — sem animações customizadas, sem atraso artificial.
        É o padrão visual usado por Gmail, Drive, Fotos, Maps etc.
    -->


</resources>
